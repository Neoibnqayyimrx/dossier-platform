# Copy to .env and adjust for your environment. Never commit the real .env.

APP_ENV=dev
APP_VERSION=0.1.0

# Postgres (docker-compose service name "db"; use localhost if running the API outside Docker)
DATABASE_URL=postgresql+psycopg://dossier:dossier@localhost:5432/dossier

# MinIO / S3 (docker-compose service name "minio"; use localhost if running the API outside Docker)
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=dossier-artifacts

# "s3" (real MinIO/S3, needs the block above) or "memory" (in-process dict,
# no MinIO needed — dev/test default)
STORAGE_PROVIDER=memory

# How DOCX->PDF conversion reaches LibreOffice (a TRANSPORT choice -- all
# three use the same LibreOffice engine and produce identical output).
#   libreoffice-listener  one persistent soffice, reused (default, ~6x
#                         faster; needs the python3-uno system package)
#   soffice-subprocess    a fresh soffice per call -- the old behaviour.
#                         Use where no listener can run.
#   gotenberg             HTTP to a Gotenberg container. Start one with
#                         `docker compose --profile gotenberg up -d`.
# See docs/decisions/0002-document-converter.md.
DOCUMENT_CONVERTER=libreoffice-listener
# 0 = pick a free port automatically (recommended)
SOFFICE_LISTENER_PORT=0
# Where the distro keeps LibreOffice's compiled `uno` binding. It cannot be
# pip-installed. Empty means "already importable".
UNO_PYTHON_PATH=/usr/lib/python3/dist-packages
GOTENBERG_URL=http://localhost:3000

# LLM — provider-abstracted; model name never hard-coded in business logic.
# "gemini" (real, needs LLM_API_KEY from https://aistudio.google.com/apikey
# -- Google's free tier is generous enough for this project) or "fake"
# (deterministic offline stub for dev/test, no key needed)
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
LLM_API_KEY=

# "voyage" (real, needs EMBEDDING_API_KEY) or "fake" (deterministic offline
# embedder for dev/test, no network/key needed)
EMBEDDING_PROVIDER=voyage
EMBEDDING_API_KEY=
EMBEDDING_MODEL=voyage-3-lite


