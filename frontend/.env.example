# Copy to .env.local. NEXT_PUBLIC_ values are inlined into the browser
# bundle at BUILD time -- re-run `npm run build` after changing them, and
# never put a secret in one.
#
# 127.0.0.1 rather than localhost on purpose: if localhost resolves to ::1
# first and the API is bound to IPv4 only, the browser reports the failure
# as a CORS error that isn't one. See README.md.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
